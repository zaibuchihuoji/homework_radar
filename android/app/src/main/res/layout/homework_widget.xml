<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/w_glass" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:importantForAccessibility="no" android:visibility="gone"/>
<LinearLayout android:id="@+id/w_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="12dp">
<LinearLayout android:id="@+id/w_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="top" android:baselineAligned="false" android:layout_marginBottom="6dp">
<TextView android:id="@+id/w_title" android:layout_width="0dp" android:layout_height="wrap_content" android:text="最近作业" android:textSize="15sp" android:textColor="#151B2B" android:includeFontPadding="false" android:textStyle="bold" android:layout_weight="1" android:maxLines="2" android:breakStrategy="balanced" android:hyphenationFrequency="none" android:ellipsize="end"/>
<TextView android:id="@+id/w_mark" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TODAY" android:textSize="10sp" android:textColor="#514112" android:includeFontPadding="false" android:background="@drawable/widget_focus_yellow" android:padding="4dp" android:layout_marginStart="6dp" android:maxLines="1" android:textStyle="bold"/>
</LinearLayout>
<TextView android:id="@+id/w_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:textColor="#686254" android:includeFontPadding="false" android:layout_marginTop="7dp" android:maxLines="1" android:ellipsize="end"/>
<!-- Short lists sit in the middle; long lists are measured within the same
     bounded viewport and remain native, scrollable collections. -->
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
<ListView android:id="@+id/w_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:divider="@null" android:dividerHeight="0dp" android:scrollbars="none" android:clipToPadding="true"/>
<TextView android:id="@+id/w_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:text="暂无待办作业" android:textSize="14sp" android:textColor="#686254" android:includeFontPadding="false" android:gravity="center" android:breakStrategy="high_quality" android:hyphenationFrequency="none" android:visibility="gone"/>
</FrameLayout>
<TextView android:id="@+id/w_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:textColor="#686254" android:includeFontPadding="false" android:layout_marginTop="5dp" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout></FrameLayout>
