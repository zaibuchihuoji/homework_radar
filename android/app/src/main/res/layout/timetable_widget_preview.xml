<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
  <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:importantForAccessibility="no" android:visibility="gone" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
      <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="下一节课" android:textSize="15sp" android:textColor="#151B2B" android:includeFontPadding="false" android:textStyle="bold" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="第7周" android:textSize="10sp" android:textColor="#514112" android:includeFontPadding="false" android:background="@drawable/widget_focus_yellow" android:padding="5dp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:textColor="#686254" android:includeFontPadding="false" android:layout_marginTop="7dp" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:orientation="vertical" android:background="@drawable/widget_focus_yellow" android:padding="7dp" android:layout_marginBottom="5dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="计算机网络" android:textSize="14sp" android:textColor="#151B2B" android:includeFontPadding="false" android:layout_weight="1" android:maxLines="2" android:ellipsize="end" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:textColor="#514112" android:includeFontPadding="false" android:layout_marginStart="6dp" android:maxLines="1" android:visibility="gone" />
      </LinearLayout>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="14:00–15:40 · 下一节" android:textSize="12sp" android:textColor="#686254" android:includeFontPadding="false" android:layout_marginTop="5dp" android:maxLines="1" android:ellipsize="end" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="教学楼 A302" android:textSize="12sp" android:textColor="#686254" android:includeFontPadding="false" android:layout_marginTop="3dp" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="0dp" android:text="今天没有课" android:textSize="14sp" android:textColor="#686254" android:includeFontPadding="false" android:layout_weight="1" android:gravity="center" android:visibility="gone" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:textColor="#686254" android:includeFontPadding="false" android:layout_marginTop="5dp" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
  </LinearLayout>
</FrameLayout>