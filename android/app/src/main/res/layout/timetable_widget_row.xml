<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/tt_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_vertical" android:background="@drawable/widget_study_row" android:padding="7dp" android:layout_marginBottom="5dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<TextView android:hyphenationFrequency="none" android:id="@+id/tt_name" android:breakStrategy="balanced" android:layout_width="0dp" android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:textColor="#151B2B" android:includeFontPadding="false" android:layout_weight="1" android:maxLines="2" android:ellipsize="end" android:textStyle="bold"/>
<TextView android:breakStrategy="high_quality" android:hyphenationFrequency="none" android:id="@+id/tt_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:textColor="#514112" android:includeFontPadding="false" android:layout_marginStart="6dp" android:maxLines="1"/>
</LinearLayout>
<TextView android:breakStrategy="high_quality" android:hyphenationFrequency="none" android:id="@+id/tt_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:textColor="#686254" android:includeFontPadding="false" android:layout_marginTop="3dp" android:maxLines="1" android:ellipsize="end"/>
<TextView android:breakStrategy="high_quality" android:hyphenationFrequency="none" android:id="@+id/tt_room" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:textColor="#686254" android:includeFontPadding="false" android:layout_marginTop="3dp" android:maxLines="2" android:ellipsize="end"/>
</LinearLayout>