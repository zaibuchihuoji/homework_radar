<?xml version="1.0" encoding="utf-8"?>
<!-- 清玻璃面板（vivo 图标式配方）：
     壁纸清晰透出（不模糊、不压暗），玻璃感全部来自「双线切面边框」：
       ① 极轻暗压（8%→3%）：让面板"坐"在壁纸上，无遮罩感
       ② 内侧高光线：2dp 内缩、细亮、完整一圈
       ③ 外圈主描边：亮、锐利
     双线之间是玻璃厚度。圆角与系统掩模 ≈21dp 同心。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- ① 极轻暗压本体 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#14000000"
                android:centerColor="#0A000000"
                android:endColor="#08000000"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <!-- ② 外圈主描边（玻璃切面）：单线，亮而细——大面板上双线读成"两条平行线"，故去内线 -->
    <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <corners android:radius="20dp"/>
            <stroke android:width="1dp" android:color="#73FFFFFF"/>
        </shape>
    </item>
</layer-list>
