<?xml version="1.0" encoding="utf-8"?>
<!-- 透明模式的回退背景：仅当壁纸拿不到（动态壁纸等）时使用，
     正常情况走 GlassWallpaperRenderer 的壁纸折射位图 + widget_bg_rim 描边。
     清澈玻璃（苹果 iOS 26 质感，不是毛玻璃），玻璃感全靠四层叠加：
       ① 玻璃本体：顶部受光略亮、往下渐澈的白纱——压得住壁纸但不糊成白雾；
       ② 底缘折射暗边：贴底一条向上渐隐的深色，玻璃因此有了厚度；
       ③ 顶部高光：液态玻璃的签名——顶边一条渐隐的亮线，光从上来；
       ④ 外缘亮边：只负责"边缘"，配合②③形成上亮下暗的受光，不再像贴纸描边。
     实测 Pixel 桌面系统圆角掩模半径 ≈ 21dp（56px @2.625x）：
     内缩 1dp + 半径 20dp 与掩模同心，四角不露壁纸缝。
     高光/暗边两侧内缩（10dp/4dp）避开圆角段，模拟真实玻璃面内反射。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- ① 玻璃本体 -->
    <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#40FFFFFF"
                android:centerColor="#22FFFFFF"
                android:endColor="#10FFFFFF"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <!-- ② 底缘折射暗边（厚度） -->
    <item
        android:height="6dp"
        android:gravity="bottom"
        android:left="4dp"
        android:right="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#00101820"
                android:endColor="#33101820"/>
            <corners android:radius="3dp"/>
        </shape>
    </item>
    <!-- ③ 顶部受光高光：与亮边之间留 2dp 玻璃暗隙，读作两条分离的受光线 -->
    <item
        android:height="2dp"
        android:gravity="top"
        android:top="5dp"
        android:left="12dp"
        android:right="12dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#C8FFFFFF"
                android:endColor="#00FFFFFF"/>
            <corners android:radius="1dp"/>
        </shape>
    </item>
    <!-- ④ 外缘亮边 -->
    <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <corners android:radius="20dp"/>
            <stroke android:width="2dp" android:color="#A6FFFFFF"/>
        </shape>
    </item>
</layer-list>
